root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.kt]
insert_final_newline = true
ktlint_disabled_rules=trailing-comma

[**/build/generated/**]
ktlint_disabled_rules=indent,needless_blank_line,insert_final_newline
disabled_rules = filename,import-order

[**/core/strings/*.kt]
max_line_length = off
